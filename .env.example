ENVIRONMENT=development
TEST_MODE=true

# Data Engine — fonte de dados: Bybit (seção 3), pública, sem API key.
# SCAN_ASSETS=AUTO ativa a descoberta dinâmica de símbolos USDT Perpetual
# na própria Bybit (seção 4); deixe a lista manual (ex.: BTCUSDT,ETHUSDT)
# para manter o comportamento atual.
SCAN_ASSETS=BTCUSDT,ETHUSDT
SCAN_TIMEFRAMES=15m,1h,4h
MIN_SYMBOLS=50
MAX_SYMBOLS=100
SCAN_INTERVAL_MINUTES=15
REPORT_INTERVAL_MINUTES=60

DATABASE_URL=postgresql://user:password@host:5432/alphaquantx
REDIS_URL=

TRADINGVIEW_WEBHOOK_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_SIGNALS_CHAT_ID=
TELEGRAM_FUTURE_CHAT_ID=
# Secret arbitrário definido no `setWebhook` (ver docs/DEPLOY.md) — o
# Telegram devolve esse mesmo valor no header X-Telegram-Bot-Api-Secret-Token
# em todo update, e o endpoint POST /webhooks/telegram rejeita qualquer
# request sem ele bater. Opcional só pra não travar quem ainda não configurou
# o webhook, mas fortemente recomendado em produção.
TELEGRAM_WEBHOOK_SECRET=
# Quantos segundos o worker espera entre cada checagem de /analisar
# pendente enquanto aguarda o próximo fechamento de vela automático.
MANUAL_SCAN_POLL_SECONDS=5

MARKET_DATA_API_KEY=
# Não usada pelo Data Engine (klines/ticker/orderbook da Bybit são
# públicos, sem API key). Reservada para expansões futuras (CoinGlass,
# Fear & Greed Index etc., conforme o [[alphaquant-engine]]).

JWT_SECRET=
